# RCC Cafe - Environment Variables (template)
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local or any file containing real keys.

# Supabase project URL (safe for frontend)
VITE_SUPABASE_URL=

# Supabase ANON public key (safe for frontend, RLS-protected)
VITE_SUPABASE_ANON_KEY=

# NOTE: The Supabase SERVICE ROLE KEY must NEVER be placed here or in any
# VITE_ variable. It bypasses RLS and is for trusted server-side use only.
